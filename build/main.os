#Использовать "src/domain"
#Использовать "src/common"
#Использовать "src/adapters"
#Использовать "src/handlers"
#Использовать "src/usecases"
#Использовать "src"

РеестрОбработчиков = Новый Соответствие;
РеестрОбработчиков.Вставить("bsl_search", Истина);
РеестрОбработчиков.Вставить("xml_search", Истина);
РеестрОбработчиков.Вставить("config_list", Истина);
РеестрОбработчиков.Вставить("read_module", Истина);

Пока Истина Цикл
	СтрокаВвода = StdioAdapter.ПрочитатьСтроку();
	Если СтрокаВвода = Неопределено Тогда
		Прервать;
	КонецЕсли;
	Если СтрокаВвода = "" Тогда
		Продолжить;
	КонецЕсли;
	ИдЗапроса = Неопределено;
	Попытка
		Разобранное = JsonRpcSerializer.РазобратьСтроку(СтрокаВвода);
		ИдЗапроса = Разобранное.Получить("id");
		Если ИдЗапроса = Неопределено Тогда
			ИдЗапроса = Разобранное.Получить("Id");
		КонецЕсли;
		Ответ = Неопределено;
		Если Разобранное.Получить("ОшибкаПарсинга") = Истина Тогда
			Ид = Разобранное.Получить("Id");
			Если Ид = Неопределено Тогда Ид = Разобранное.Получить("id"); КонецЕсли;
			Ответ = JsonRpcSerializer.СоздатьОтветОшибкиПарсинга(Ид);
		Иначе
			Ответ = Dispatcher.Обработать(Разобранное, РеестрОбработчиков);
		КонецЕсли;
		Если Ответ <> Неопределено Тогда
			СтрокаОтвета = JsonRpcSerializer.СериализоватьОтвет(Ответ);
			StdioAdapter.ЗаписатьСтроку(СтрокаОтвета);
		КонецЕсли;
	Исключение
		StdioAdapter.ЗаписатьВОшибку("Internal error: " + ОписаниеОшибки());
		Если ИдЗапроса <> Неопределено Тогда
			Ответ = JsonRpcSerializer.СоздатьОтветВнутреннейОшибки(ИдЗапроса);
			СтрокаОтвета = JsonRpcSerializer.СериализоватьОтвет(Ответ);
			StdioAdapter.ЗаписатьСтроку(СтрокаОтвета);
		КонецЕсли;
	КонецПопытки;
КонецЦикла
