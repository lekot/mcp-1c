#Использовать "src/domain"
#Использовать "src/common"
#Использовать "src/adapters"
#Использовать "src/handlers"
#Использовать "src/usecases"
#Использовать "src"

// Путь по умолчанию (БД справки, соседние модули) — относительно каталога точки входа (как #Использовать "src/..." и "../" в тестах).
ПутьСкрипта = "main.os";
Если АргументыКоманднойСтроки.Количество() > 0 И Не ПустаяСтрока(АргументыКоманднойСтроки[0]) Тогда
	ПутьСкрипта = АргументыКоманднойСтроки[0];
КонецЕсли;
Ф = Новый Файл(ПутьСкрипта);
НормПуть = СтрЗаменить(Ф.ПолноеИмя, "\", "/");
Поз = СтрНайти(НормПуть, "/", НаправлениеПоиска.СКонца);
Если Поз > 0 Тогда
	КаталогСкрипта = Лев(НормПуть, Поз - 1);
	УстановитьТекущийКаталог(КаталогСкрипта);
	АбсолютныйПутьКБД = FileSystem.ОбъединитьПути(КаталогСкрипта, "src/data/shcntx_help.db");
	ПутьФайлаДефолта = FileSystem.ОбъединитьПути(КаталогСкрипта, "shcntx_help_db_path.txt");
	Попытка
		// На Windows путь с / может не открыться — используем нативный разделитель для записи
		ПутьДляЗаписи = СтрЗаменить(ПутьФайлаДефолта, "/", "\");
		Запись = Новый ЗаписьТекста(ПутьДляЗаписи, КодировкаТекста.UTF8);
		Запись.Записать(АбсолютныйПутьКБД);
		Запись.Закрыть();
	Исключение
		StdioAdapter.ЗаписатьВОшибку("MCP: не удалось записать shcntx_help_db_path.txt в " + ПутьФайлаДефолта + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецЕсли;

РеестрОбработчиков = Новый Соответствие;
РеестрОбработчиков.Вставить("bsl_search", Истина);
РеестрОбработчиков.Вставить("xml_search", Истина);
РеестрОбработчиков.Вставить("config_list", Истина);
РеестрОбработчиков.Вставить("read_module", Истина);
РеестрОбработчиков.Вставить("syntax_help_search", Истина);

Пока Истина Цикл
	СтрокаВвода = StdioAdapter.ПрочитатьСтроку();
	Если СтрокаВвода = Неопределено Тогда
		Прервать;
	КонецЕсли;
	Если СтрокаВвода = "" Тогда
		Продолжить;
	КонецЕсли;
	ИдЗапроса = Неопределено;
	Попытка
		Разобранное = JsonRpcSerializer.РазобратьСтроку(СтрокаВвода);
		ИдЗапроса = Разобранное.Получить("id");
		Если ИдЗапроса = Неопределено Тогда
			ИдЗапроса = Разобранное.Получить("Id");
		КонецЕсли;
		Ответ = Неопределено;
		Если Разобранное.Получить("ОшибкаПарсинга") = Истина Тогда
			Ид = Разобранное.Получить("Id");
			Если Ид = Неопределено Тогда Ид = Разобранное.Получить("id"); КонецЕсли;
			Ответ = JsonRpcSerializer.СоздатьОтветОшибкиПарсинга(Ид);
		Иначе
			Ответ = Dispatcher.Обработать(Разобранное, РеестрОбработчиков);
		КонецЕсли;
		Если Ответ <> Неопределено Тогда
			СтрокаОтвета = JsonRpcSerializer.СериализоватьОтвет(Ответ);
			StdioAdapter.ЗаписатьСтроку(СтрокаОтвета);
		КонецЕсли;
	Исключение
		StdioAdapter.ЗаписатьВОшибку("Internal error: " + ОписаниеОшибки());
		Если ИдЗапроса <> Неопределено Тогда
			Ответ = JsonRpcSerializer.СоздатьОтветВнутреннейОшибки(ИдЗапроса);
			СтрокаОтвета = JsonRpcSerializer.СериализоватьОтвет(Ответ);
			StdioAdapter.ЗаписатьСтроку(СтрокаОтвета);
		КонецЕсли;
	КонецПопытки;
КонецЦикла
