// Диспетчер методов JSON-RPC (contracts §3, §6). По method вызывается initialize, tools/list, tools/call; Notification — без ответа.
// Зависимости подключаются через #Использовать "src" в точке входа.
// Константы JSON-RPC (Перем Экспорт из McpProtocol.os не видны в scope библиотечного модуля — используем литералы).

// Обработать разобранное сообщение. Возврат: объект Response (Соответствие) или Неопределено (Notification — ответ не отправлять).
Функция Обработать(Сообщение, РеестрОбработчиков) Экспорт
	Если McpProtocol.ЭтоУведомление(Сообщение) Тогда
		// notifications/initialized и др. — ответ не отправляется.
		Возврат Неопределено;
	КонецЕсли;
	Ид = Сообщение.Получить("id");
	Метод = Сообщение.Получить("method");
	Параметры = Сообщение.Получить("params");
	Если Метод = Неопределено Или ПустаяСтрока(Метод) Тогда
		Возврат СоздатьОтветСОшибкой(Ид, -32602, "Invalid params: method required");
	КонецЕсли;
	Метод = Строка(Метод);
	Попытка
		Если Метод = "initialize" Тогда
			Результат = InitializeSession.ИнициализироватьСессию(?(Параметры = Неопределено, Новый Соответствие, Параметры));
			Возврат СоздатьОтветУспех(Ид, Результат);
		КонецЕсли;
		Если Метод = "tools/list" Тогда
			Результат = ListTools.ПолучитьСписокИнструментов();
			Возврат СоздатьОтветУспех(Ид, Результат);
		КонецЕсли;
		Если Метод = "tools/call" Тогда
			Если ТипЗнч(Параметры) <> Тип("Соответствие") И ТипЗнч(Параметры) <> Тип("Структура") Тогда
				Возврат СоздатьОтветСОшибкой(Ид, -32602, "Invalid params: params must be object for tools/call");
			КонецЕсли;
			ИмяИнструмента = ПолучитьПоле(Параметры, "name");
			Аргументы = ПолучитьПоле(Параметры, "arguments");
			Если ПустаяСтрока(ИмяИнструмента) Тогда
				Возврат СоздатьОтветСОшибкой(Ид, -32602, "Invalid params: name required");
			КонецЕсли;
			Если Аргументы = Неопределено Тогда
				Аргументы = Новый Соответствие;
			КонецЕсли;
			Результат = CallTool.ВызватьИнструмент(Строка(ИмяИнструмента), Аргументы, РеестрОбработчиков);
			Возврат СоздатьОтветУспех(Ид, Результат);
		КонецЕсли;
		Возврат СоздатьОтветСОшибкой(Ид, -32601, "Method not found");
	Исключение
		StdioAdapter.ЗаписатьВОшибку("Dispatcher error: " + ОписаниеОшибки());
		Возврат СоздатьОтветСОшибкой(Ид, -32603, "Internal error");
	КонецПопытки;
КонецФункции

Функция СоздатьОтветУспех(Ид, Результат)
	Ответ = Новый Соответствие;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", JsonRpcSerializer.НормализоватьИдОтвета(Ид));
	Ответ.Вставить("result", Результат);
	Возврат Ответ;
КонецФункции

Функция СоздатьОтветСОшибкой(Ид, Код, Сообщение)
	Ошибка = Новый Соответствие;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Ответ = Новый Соответствие;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", JsonRpcSerializer.НормализоватьИдОтвета(Ид));
	Ответ.Вставить("error", Ошибка);
	Возврат Ответ;
КонецФункции

Функция ПолучитьПоле(Объект, Ключ)
	Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Возврат Объект.Получить(Ключ);
	КонецЕсли;
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Если Объект.Свойство(Ключ) Тогда
			Возврат Объект[Ключ];
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
