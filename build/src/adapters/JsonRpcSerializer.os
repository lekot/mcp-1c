// Адаптер JSON-RPC: строка ↔ объект Request/Notification/Response (contracts §1, §2, §6.2).
// ADR-4: встроенные средства OneScript (ЧтениеJson, ЗаписьJson).
// Самодостаточный модуль: не обращается к Перем Экспорт других библиотек.

// Рекурсивно конвертирует Структура/вложенные Структуры в Соответствие, чтобы всё дерево объектов
// допускало .Получить(). Примитивы и Массивы с примитивами обрабатываются на месте.
Функция _ВСоответствие(Данные)
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Рез = Новый Соответствие;
		Для Каждого КлЗнч Из Данные Цикл
			Рез.Вставить(КлЗнч.Ключ, _ВСоответствие(КлЗнч.Значение));
		КонецЦикла;
		Возврат Рез;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Рез = Новый Массив;
		Для Каждого Эл Из Данные Цикл
			Рез.Добавить(_ВСоответствие(Эл));
		КонецЦикла;
		Возврат Рез;
	КонецЕсли;
	Возврат Данные;
КонецФункции

// Создать Соответствие-ошибку парсинга для возврата из РазобратьСтроку.
Функция _ОшибкаПарсингаСоответствие(Ид)
	Рез = Новый Соответствие;
	Рез.Вставить("ОшибкаПарсинга", Истина);
	Рез.Вставить("Код", -32700);
	Рез.Вставить("Id", Ид);
	Возврат Рез;
КонецФункции

// Нормализовать входящую строку: убрать BOM, ведущие/завершающие управляющие символы и пробелы.
Функция _НормализоватьВход(СтрокаВход)
	Если ПустаяСтрока(СтрокаВход) Тогда Возврат СтрокаВход; КонецЕсли;
	// Ведущие: BOM (U+FEFF, или байты 239,187,191), UTF-16 BOM (255,254 / 254,255), управляющие (0..32), DEL (127).
	Пока СтрДлина(СтрокаВход) > 0 Цикл
		Первый = КодСимвола(Лев(СтрокаВход, 1));
		Если Первый = 123 Тогда
			Прервать;
		КонецЕсли;
		Если СтрДлина(СтрокаВход) >= 2 Тогда
			Второй = КодСимвола(Сред(СтрокаВход, 2, 1));
			Если (Первый = 255 И Второй = 254) Или (Первый = 254 И Второй = 255) Тогда
				СтрокаВход = Сред(СтрокаВход, 3);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если Первый = 65279 Или Первый = 239 Или Первый = 187 Или Первый = 191 Тогда
			СтрокаВход = Сред(СтрокаВход, 2);
			Продолжить;
		КонецЕсли;
		Если (Первый >= 0 И Первый <= 32) Или Первый = 127 Тогда
			СтрокаВход = Сред(СтрокаВход, 2);
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	// Завершающие \r, \n, пробел, таб
	Пока СтрДлина(СтрокаВход) > 0 Цикл
		Последний = КодСимвола(Прав(СтрокаВход, 1));
		Если Последний = 13 Или Последний = 10 Или Последний = 32 Или Последний = 9 Тогда
			СтрокаВход = Лев(СтрокаВход, СтрДлина(СтрокаВход) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// Если после обрезки не начинается с '{', взять подстроку с первого '{' до конца (на случай мусора до JSON).
	Если СтрДлина(СтрокаВход) > 0 И КодСимвола(Лев(СтрокаВход, 1)) <> 123 Тогда
		Поз = СтрНайти(СтрокаВход, Символ(123));
		Если Поз > 0 Тогда
			СтрокаВход = Сред(СтрокаВход, Поз);
		КонецЕсли;
	КонецЕсли;
	Возврат СтрокаВход;
КонецФункции

// Извлечь один корневой объект {...} по подсчёту скобок (игнорируя { } внутри строк). Убирает хвост после JSON.
Функция _ИзвлечьКорневойОбъект(СтрокаВход)
	Длина = СтрДлина(СтрокаВход);
	ПозНачало = СтрНайти(СтрокаВход, Символ(123));
	Если ПозНачало <= 0 Тогда Возврат СтрокаВход; КонецЕсли;
	Счетчик = 1;
	ВСтроке = Ложь;
	Экранирование = Ложь;
	КонецПозиция = 0;
	Для Поз = ПозНачало + 1 По Длина Цикл
		Сим = Сред(СтрокаВход, Поз, 1);
		Код = КодСимвола(Сим);
		Если Экранирование Тогда
			Экранирование = Ложь;
			Продолжить;
		КонецЕсли;
		Если ВСтроке Тогда
			Если Код = 34 Тогда ВСтроке = Ложь;
			ИначеЕсли Код = 92 Тогда Экранирование = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Код = 123 Тогда
			Счетчик = Счетчик + 1;
		ИначеЕсли Код = 125 Тогда
			Счетчик = Счетчик - 1;
			Если Счетчик = 0 Тогда КонецПозиция = Поз; Прервать; КонецЕсли;
		ИначеЕсли Код = 34 Тогда
			ВСтроке = Истина;
		КонецЕсли;
	КонецЦикла;
	Если КонецПозиция > 0 Тогда
		Возврат Сред(СтрокаВход, ПозНачало, КонецПозиция - ПозНачало + 1);
	КонецЕсли;
	Возврат СтрокаВход;
КонецФункции

// Парсинг строки UTF-8 в объект (Request или Notification).
// Возврат: Соответствие с полями jsonrpc, id?, method, params?.
// При ошибке парсинга: Возврат["ОшибкаПарсинга"] = Истина, ["Код"] = -32700, ["Id"] = null.
Функция РазобратьСтроку(СтрокаВход) Экспорт
	СтрокаВход = _НормализоватьВход(СтрокаВход);
	СтрокаВход = _ИзвлечьКорневойОбъект(СтрокаВход);
	Если ПустаяСтрока(СтрокаВход) Тогда
		Возврат _ОшибкаПарсингаСоответствие(Неопределено);
	КонецЕсли;
	Попытка
		ЧтениеJson = Новый ЧтениеJson;
		ЧтениеJson.УстановитьСтроку(СтрокаВход);
		// Истина = читать в Соответствие (не Структура) — принимает любые ключи, в т.ч. с / и .
		Данные = ПрочитатьJSON(ЧтениеJson, Истина);
		ЧтениеJson.Закрыть();
		Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Соответствие") Тогда
			Возврат _ОшибкаПарсингаСоответствие(ПрочитатьIdИзСтроки(СтрокаВход));
		КонецЕсли;
		Возврат Данные;
	Исключение
		Возврат _ОшибкаПарсингаСоответствие(ПрочитатьIdИзСтроки(СтрокаВход));
	КонецПопытки;
КонецФункции

Функция ПрочитатьIdИзСтроки(СтрокаВход)
	Попытка
		ЧтениеJson = Новый ЧтениеJson;
		ЧтениеJson.УстановитьСтроку(СтрокаВход);
		Пока ЧтениеJson.Прочитать() Цикл
			Если ЧтениеJson.ИмяСвойства = "id" Тогда
				Ид = ЧтениеJson.ТекущееЗначение;
				ЧтениеJson.Закрыть();
				Возврат Ид;
			КонецЕсли;
		КонецЦикла;
		ЧтениеJson.Закрыть();
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Сериализация объекта Response (result или error) в строку UTF-8 (одна строка JSON, без \n).
// ЗаписьJSON.Закрыть() возвращает сериализованную строку. Переводы строк убираем — в JSON-данных
// они экранированы как \n, поэтому удаление литеральных \r\n безопасно.
Функция СериализоватьОтвет(ОбъектОтвета) Экспорт
	ЗаписьJson = Новый ЗаписьJSON;
	ЗаписьJson.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJson, ОбъектОтвета);
	Строка = ЗаписьJson.Закрыть();
	Строка = СтрЗаменить(Строка, Символ(13), "");
	Строка = СтрЗаменить(Строка, Символ(10), "");
	Строка = СтрЗаменить(Строка, Символ(9), "");
	Возврат Строка;
КонецФункции

// Клиент (Cursor) не принимает id: null в ответе — ожидает string или number. Подставляем 0 при отсутствии id.
Функция НормализоватьИдОтвета(Ид) Экспорт
	Если Ид = Неопределено Тогда Возврат 0; КонецЕсли;
	Если ТипЗнч(Ид) = Тип("Число") Тогда Возврат Ид; КонецЕсли;
	Если ТипЗнч(Ид) = Тип("Строка") Тогда Возврат Ид; КонецЕсли;
	Возврат 0;
КонецФункции

// Сформировать объект Response с error для кода -32700.
Функция СоздатьОтветОшибкиПарсинга(Ид) Экспорт
	Ошибка = Новый Соответствие;
	Ошибка.Вставить("code", -32700);
	Ошибка.Вставить("message", "Parse error");
	Ответ = Новый Соответствие;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", НормализоватьИдОтвета(Ид));
	Ответ.Вставить("error", Ошибка);
	Возврат Ответ;
КонецФункции

// Сформировать объект Response с error для кода -32603 (Internal error).
Функция СоздатьОтветВнутреннейОшибки(Ид) Экспорт
	Ошибка = Новый Соответствие;
	Ошибка.Вставить("code", -32603);
	Ошибка.Вставить("message", "Internal error");
	Ответ = Новый Соответствие;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", НормализоватьИдОтвета(Ид));
	Ответ.Вставить("error", Ошибка);
	Возврат Ответ;
КонецФункции
