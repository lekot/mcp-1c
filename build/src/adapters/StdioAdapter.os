// Адаптер stdio: чтение одной строки из stdin, запись одной строки в stdout + \n, логи в stderr (contracts §1, ADR-3).
// Единственная точка записи в stdout в приложении.
// Потоки открываются лениво через Консоль.ОткрытьСтандартныйПоток* и кешируются в модульных переменных.
// После каждой записи вызывается Поток.Flush() — ЗаписьТекста буферизует данные и без flush
// Cursor не получает ответ вовремя (зависание при handshake).

Перем _ЧитательВвода;
Перем _ЗаписьВывода;
Перем _ПотокВывода;
Перем _ЗаписьОшибок;
Перем _ПотокОшибок;

Функция _ПолучитьЧитательВвода()
	Если _ЧитательВвода = Неопределено Тогда
		_ЧитательВвода = Новый ЧтениеТекста(Консоль.ОткрытьСтандартныйПотокВвода(), "UTF-8");
	КонецЕсли;
	Возврат _ЧитательВвода;
КонецФункции

Процедура _ИнициализироватьВывод()
	Если _ЗаписьВывода = Неопределено Тогда
		_ПотокВывода = Консоль.ОткрытьСтандартныйПотокВывода();
		_ЗаписьВывода = Новый ЗаписьТекста(_ПотокВывода, "UTF-8");
	КонецЕсли;
КонецПроцедуры

Процедура _ИнициализироватьОшибки()
	Если _ЗаписьОшибок = Неопределено Тогда
		_ПотокОшибок = Консоль.ОткрытьСтандартныйПотокОшибок();
		_ЗаписьОшибок = Новый ЗаписьТекста(_ПотокОшибок, "UTF-8");
	КонецЕсли;
КонецПроцедуры

// Прочитать одну строку до \n или EOF из stdin. Возвращает строку без завершающего \n; при EOF — Неопределено (чтобы main не путал EOF с пустой строкой).
Функция ПрочитатьСтроку() Экспорт
	Возврат _ПолучитьЧитательВвода().ПрочитатьСтроку();
КонецФункции

// Записать одну строку в stdout и перевод строки (\n). Кодировка UTF-8 по контракту.
Процедура ЗаписатьСтроку(СтрокаОтвета) Экспорт
	_ИнициализироватьВывод();
	_ЗаписьВывода.Записать(СтрокаОтвета + Символ(10));
	_ПотокВывода.Flush();
КонецПроцедуры

// Записать сообщение в stderr (логи). В stdout не выводить.
Процедура ЗаписатьВОшибку(Сообщение) Экспорт
	_ИнициализироватьОшибки();
	_ЗаписьОшибок.Записать(Сообщение + Символ(10));
	_ПотокОшибок.Flush();
КонецПроцедуры
