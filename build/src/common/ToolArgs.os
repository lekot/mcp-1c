// Общий модуль извлечения аргументов инструментов (contracts §4). Используется обработчиками tools.

Функция ПолучитьЗначениеАргумента(Аргументы, Ключ) Экспорт
	ТипАрг = ТипЗнч(Аргументы);
	ТипСоп = Тип("Соответствие");
	Если ТипАрг = ТипСоп Тогда
		ЗначениеКлюча = Аргументы.Получить(Ключ);
		Если ЗначениеКлюча = Неопределено Тогда Возврат ""; КонецЕсли;
		Возврат ЗначениеКлюча;
	КонецЕсли;
	ТипСтр = Тип("Структура");
	Если ТипАрг = ТипСтр Тогда
		Если Аргументы.Свойство(Ключ) Тогда Возврат Аргументы[Ключ]; КонецЕсли;
		Возврат "";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьБулевоАргумента(Аргументы, Ключ, ПоУмолчанию) Экспорт
	ЗначениеКлюча = ПолучитьЗначениеАргумента(Аргументы, Ключ);
	Если ЗначениеКлюча = "" Или ЗначениеКлюча = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(ЗначениеКлюча) = Тип("Булево") Тогда
		Возврат ЗначениеКлюча;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ПолучитьЧислоАргумента(Аргументы, Ключ, ПоУмолчанию) Экспорт
	ЗначениеКлюча = ПолучитьЗначениеАргумента(Аргументы, Ключ);
	Если ЗначениеКлюча = "" Или ЗначениеКлюча = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(ЗначениеКлюча) = Тип("Число") Тогда
		Возврат ЗначениеКлюча;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции
