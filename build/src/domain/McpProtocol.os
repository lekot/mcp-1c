// Домен: типы и коды ошибок JSON-RPC 2.0 (contracts §2).
// Request, Response, Notification — представляются структурами/соответствиями для сериализации.

// Коды ошибок JSON-RPC 2.0 и имена полей сообщений
Перем КодОшибкиПарсинга Экспорт;
Перем КодМетодНеНайден Экспорт;
Перем КодНеверныеПараметры Экспорт;
Перем КодВнутренняяОшибка Экспорт;
Перем ПолеJsonrpc Экспорт;
Перем ПолеId Экспорт;
Перем ПолеMethod Экспорт;
Перем ПолеParams Экспорт;
Перем ПолеResult Экспорт;
Перем ПолеError Экспорт;
Перем ПолеCode Экспорт;
Перем ПолеMessage Экспорт;
Перем ПолеData Экспорт;

Процедура ИнициализироватьКонстантыПротокола()
	КодОшибкиПарсинга    = -32700;
	КодМетодНеНайден     = -32601;
	КодНеверныеПараметры = -32602;
	КодВнутренняяОшибка  = -32603;
	ПолеJsonrpc  = "jsonrpc";
	ПолеId       = "id";
	ПолеMethod   = "method";
	ПолеParams   = "params";
	ПолеResult   = "result";
	ПолеError    = "error";
	ПолеCode     = "code";
	ПолеMessage  = "message";
	ПолеData     = "data";
КонецПроцедуры

// Создать объект ошибки JSON-RPC для ответа
Функция СоздатьОшибку(Код, Сообщение, Данные = Неопределено) Экспорт
	ИнициализироватьКонстантыПротокола();
	Ошибка = Новый Структура;
	Ошибка.Вставить(ПолеCode, Код);
	Ошибка.Вставить(ПолеMessage, Сообщение);
	Если Данные <> Неопределено Тогда
		Ошибка.Вставить(ПолеData, Данные);
	КонецЕсли;
	Возврат Ошибка;
КонецФункции

// Проверить, что сообщение — Notification (нет id). Парсер возвращает Соответствие — у него нет Свойство(), проверяем наличие ключа.
Функция ЭтоУведомление(ОбъектСообщения) Экспорт
	ИнициализироватьКонстантыПротокола();
	Если ТипЗнч(ОбъектСообщения) <> Тип("Соответствие") И ТипЗнч(ОбъектСообщения) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(ОбъектСообщения) = Тип("Структура") Тогда
		Возврат Не ОбъектСообщения.Свойство(ПолеId);
	КонецЕсли;
	// Соответствие: Notification = ключа "id" нет. Получить(ПолеId)=Неопределено не различает «нет ключа» и «id:null».
	Для Каждого КлЗнч Из ОбъектСообщения Цикл
		Если КлЗнч.Ключ = ПолеId Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции
