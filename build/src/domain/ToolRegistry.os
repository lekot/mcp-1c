// Домен: реестр инструментов MCP — name, description, inputSchema (contracts §4).

Функция СписокИнструментов() Экспорт
	Инструменты = Новый Массив;
	Инструменты.Добавить(ОписаниеBslSearch());
	Инструменты.Добавить(ОписаниеXmlSearch());
	Инструменты.Добавить(ОписаниеConfigList());
	Инструменты.Добавить(ОписаниеReadModule());
	Инструменты.Добавить(ОписаниеSyntaxHelpSearch());
	Возврат Инструменты;
КонецФункции

Функция ОписаниеBslSearch()
	ОписаниеPath = Новый Структура;
	ОписаниеPath.Вставить("type", "string");
	ОписаниеPath.Вставить("description", "Путь к корню выгрузки (каталог с BSL)");

	ОписаниеQuery = Новый Структура;
	ОписаниеQuery.Вставить("type", "string");
	ОписаниеQuery.Вставить("description", "Строка или регулярное выражение для поиска");

	ОписаниеUseRegex = Новый Структура;
	ОписаниеUseRegex.Вставить("type", "boolean");
	ОписаниеUseRegex.Вставить("description", "Интерпретировать query как регулярное выражение");
	ОписаниеUseRegex.Вставить("default", Ложь);

	Свойства = Новый Структура;
	Свойства.Вставить("path", ОписаниеPath);
	Свойства.Вставить("query", ОписаниеQuery);
	Свойства.Вставить("useRegex", ОписаниеUseRegex);

	Обязательные = Новый Массив;
	Обязательные.Добавить("path");
	Обязательные.Добавить("query");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);

	Инструмент = Новый Структура;
	Инструмент.Вставить("name", "bsl_search");
	Инструмент.Вставить("description", "Поиск текста или регулярного выражения по BSL-файлам в каталоге выгрузки конфигурации 1С. Возвращает совпадения с путём файла и контекстом.");
	Инструмент.Вставить("inputSchema", Схема);
	Возврат Инструмент;
КонецФункции

Функция ОписаниеXmlSearch()
	ОписаниеPath = Новый Структура;
	ОписаниеPath.Вставить("type", "string");
	ОписаниеPath.Вставить("description", "Путь к корню выгрузки (каталог с XML)");

	ОписаниеQuery = Новый Структура;
	ОписаниеQuery.Вставить("type", "string");
	ОписаниеQuery.Вставить("description", "Строка для поиска");

	Свойства = Новый Структура;
	Свойства.Вставить("path", ОписаниеPath);
	Свойства.Вставить("query", ОписаниеQuery);

	Обязательные = Новый Массив;
	Обязательные.Добавить("path");
	Обязательные.Добавить("query");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);

	Инструмент = Новый Структура;
	Инструмент.Вставить("name", "xml_search");
	Инструмент.Вставить("description", "Поиск текста по XML-файлам метаданных в каталоге выгрузки конфигурации 1С.");
	Инструмент.Вставить("inputSchema", Схема);
	Возврат Инструмент;
КонецФункции

Функция ОписаниеConfigList()
	ОписаниеPath = Новый Структура;
	ОписаниеPath.Вставить("type", "string");
	ОписаниеPath.Вставить("description", "Путь к корню выгрузки конфигурации");

	ОписаниеMaxDepth = Новый Структура;
	ОписаниеMaxDepth.Вставить("type", "integer");
	ОписаниеMaxDepth.Вставить("description", "Максимальная глубина обхода (0 — только корень)");
	ОписаниеMaxDepth.Вставить("default", 2);

	Свойства = Новый Структура;
	Свойства.Вставить("path", ОписаниеPath);
	Свойства.Вставить("maxDepth", ОписаниеMaxDepth);

	Обязательные = Новый Массив;
	Обязательные.Добавить("path");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);

	Инструмент = Новый Структура;
	Инструмент.Вставить("name", "config_list");
	Инструмент.Вставить("description", "Список объектов конфигурации: каталоги и файлы (модули) от указанного корня выгрузки. Позволяет обойти структуру без чтения содержимого.");
	Инструмент.Вставить("inputSchema", Схема);
	Возврат Инструмент;
КонецФункции

Функция ОписаниеReadModule()
	ОписаниеPath = Новый Структура;
	ОписаниеPath.Вставить("type", "string");
	ОписаниеPath.Вставить("description", "Полный путь к BSL-файлу");

	Свойства = Новый Структура;
	Свойства.Вставить("path", ОписаниеPath);

	Обязательные = Новый Массив;
	Обязательные.Добавить("path");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);

	Инструмент = Новый Структура;
	Инструмент.Вставить("name", "read_module");
	Инструмент.Вставить("description", "Прочитать содержимое одного BSL-файла (модуля) по пути. Возвращает текст файла.");
	Инструмент.Вставить("inputSchema", Схема);
	Возврат Инструмент;
КонецФункции

Функция ОписаниеSyntaxHelpSearch()
	ОписаниеDbPath = Новый Структура;
	ОписаниеDbPath.Вставить("type", "string");
	ОписаниеDbPath.Вставить("description", "Путь к файлу SQLite-БД справки (shcntx_help.db). Необязателен: если не передан, используется путь из переменной окружения или значение по умолчанию.");

	ОписаниеQuery = Новый Структура;
	ОписаниеQuery.Вставить("type", "string");
	ОписаниеQuery.Вставить("description", "Строка для поиска (подставляется в LIKE %query% по name и content)");

	ОписаниеLimit = Новый Структура;
	ОписаниеLimit.Вставить("type", "integer");
	ОписаниеLimit.Вставить("description", "Максимальное число записей в результате");
	ОписаниеLimit.Вставить("default", 20);

	Свойства = Новый Структура;
	Свойства.Вставить("dbPath", ОписаниеDbPath);
	Свойства.Вставить("query", ОписаниеQuery);
	Свойства.Вставить("limit", ОписаниеLimit);

	Обязательные = Новый Массив;
	Обязательные.Добавить("query");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);

	Инструмент = Новый Структура;
	Инструмент.Вставить("name", "syntax_help_search");
	Инструмент.Вставить("description", "Поиск по справке синтакс-помощника 1С в SQLite-БД (таблица nodes). Ищет по полям name и content через LIKE. БД должна быть собрана с флагом --no-fts5 (только таблица nodes, без FTS5).");
	Инструмент.Вставить("inputSchema", Схема);
	Возврат Инструмент;
КонецФункции
