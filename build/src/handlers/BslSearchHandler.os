// Обработчик bsl_search (contracts §4.1): поиск по BSL-файлам. Формат результата: путь:номер:фрагмент. UTF-8.
// useRegex: при Истина — query как регулярное выражение (встроенный тип РегулярноеВыражение OneScript 2.0); при Ложь — поиск подстроки (СтрНайти).

Функция ВыполнитьBslSearch(Аргументы) Экспорт
	Путь = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "path");
	Запрос = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "query");
	ИспользоватьRegex = ToolArgs.ПолучитьБулевоАргумента(Аргументы, "useRegex", Ложь);
	Если ПустаяСтрока(Путь) Тогда
		Возврат Новый Структура("Текст, Ошибка", "Argument 'path' is required", Истина);
	КонецЕсли;
	Если ПустаяСтрока(Запрос) Тогда
		Возврат Новый Структура("Текст, Ошибка", "Argument 'query' is required", Истина);
	КонецЕсли;
	РегулярноеВыражение = Неопределено;
	Если ИспользоватьRegex Тогда
		Попытка
			РегулярноеВыражение = Новый РегулярноеВыражение(Запрос);
		Исключение
			Возврат Новый Структура("Текст, Ошибка", "Недопустимое регулярное выражение: " + ОписаниеОшибки(), Истина);
		КонецПопытки;
	КонецЕсли;
	Попытка
		Если Не FileSystem.КаталогСуществует(Путь) Тогда
			Возврат Новый Структура("Текст, Ошибка", "Directory not found: " + Путь, Истина);
		КонецЕсли;
		ФайлыBsl = НайтиФайлы(Путь, "*.bsl", Истина);
		Результат = Новый Массив;
		Для Каждого ФайлИнфо Из ФайлыBsl Цикл
			Если ФайлИнфо.ЭтоКаталог() Тогда Продолжить; КонецЕсли;
			ПолныйПуть = ФайлИнфо.ПолноеИмя;
			ТекстФайла = FileSystem.ПрочитатьФайлКакТекст(ПолныйПуть);
			Строки = СтрРазделить(ТекстФайла, Символ(10), Ложь);
			НомерСтроки = 0;
			Для Каждого СтрокаТекста Из Строки Цикл
				НомерСтроки = НомерСтроки + 1;
				Совпадает = Ложь;
				Если ИспользоватьRegex Тогда
					Совпадает = РегулярноеВыражение.Совпадает(СтрокаТекста);
				Иначе
					Совпадает = (СтрНайти(СтрокаТекста, Запрос) > 0);
				КонецЕсли;
				Если Совпадает Тогда
					Результат.Добавить(ПолныйПуть + ":" + Формат(НомерСтроки, "ЧГ=0") + ":" + СтрокаТекста);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Текст = СтрСоединить(Результат, Символ(10));
		Возврат Новый Структура("Текст, Ошибка", Текст, Ложь);
	Исключение
		Возврат Новый Структура("Текст, Ошибка", "Error searching BSL: " + ОписаниеОшибки(), Истина);
	КонецПопытки;
КонецФункции
