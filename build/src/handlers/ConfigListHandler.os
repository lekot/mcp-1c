// Обработчик config_list (contracts §4.3): дерево каталогов/файлов с отступами (два пробела на уровень).


Функция ВыполнитьConfigList(Аргументы) Экспорт
	Путь = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "path");
	Если ПустаяСтрока(Путь) Тогда
		Возврат Новый Структура("Текст, Ошибка", "Argument 'path' is required", Истина);
	КонецЕсли;
	МаксГлубина = ToolArgs.ПолучитьЧислоАргумента(Аргументы, "maxDepth", 2);
	Попытка
		Если Не FileSystem.КаталогСуществует(Путь) Тогда
			Возврат Новый Структура("Текст, Ошибка", "Directory not found: " + Путь, Истина);
		КонецЕсли;
		Строки = Новый Массив;
		ДобавитьСтрокиДерева(Путь, "", 0, МаксГлубина, Строки);
		Текст = СтрСоединить(Строки, Символ(10));
		Возврат Новый Структура("Текст, Ошибка", Текст, Ложь);
	Исключение
		Возврат Новый Структура("Текст, Ошибка", "Error listing config: " + ОписаниеОшибки(), Истина);
	КонецПопытки;
КонецФункции

Процедура ДобавитьСтрокиДерева(Корень, ОтносительныйПуть, Уровень, МаксГлубина, Строки)
	РаздПути = FileSystem.РазделительПути();
	Каталог = Новый Файл(FileSystem.ОбъединитьПути(Корень, ОтносительныйПуть));
	Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда Возврат; КонецЕсли;
	Найденные = НайтиФайлы(Каталог.ПолноеИмя, "*", Ложь);
	Для Каждого Найденный Из Найденные Цикл
		ОтнПуть = ?(ПустаяСтрока(ОтносительныйПуть), Найденный.Имя, ОтносительныйПуть + РаздПути + Найденный.Имя);
		Отступ = ПовторитьСтроку("  ", Уровень);
		Строки.Добавить(Отступ + ОтнПуть);
		Если Найденный.ЭтоКаталог() И Уровень < МаксГлубина Тогда
			ДобавитьСтрокиДерева(Корень, ОтнПуть, Уровень + 1, МаксГлубина, Строки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПовторитьСтроку(Стр, Раз)
	Результат = "";
	Для Инд = 1 По Раз Цикл
		Результат = Результат + Стр;
	КонецЦикла;
	Возврат Результат;
КонецФункции
