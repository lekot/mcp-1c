// Обработчик read_module (contracts §4.4): прочитать один BSL-файл по пути. UTF-8.


Функция ВыполнитьReadModule(Аргументы) Экспорт
	Путь = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "path");
	Если ПустаяСтрока(Путь) Тогда
		Возврат Новый Структура("Текст, Ошибка", "Argument 'path' is required", Истина);
	КонецЕсли;
	Попытка
		Если Не FileSystem.ФайлСуществует(Путь) Тогда
			Возврат Новый Структура("Текст, Ошибка", "File not found: " + Путь, Истина);
		КонецЕсли;
		Текст = FileSystem.ПрочитатьФайлКакТекст(Путь);
		Возврат Новый Структура("Текст, Ошибка", Текст, Ложь);
	Исключение
		Возврат Новый Структура("Текст, Ошибка", "Error reading file: " + ОписаниеОшибки(), Истина);
	КонецПопытки;
КонецФункции
