// Обработчик read_module (contracts §4.4): читает BSL-модуль по пути.
// path = файл: возвращает модуль целиком (method не задан), список объявлений (method="*") или тело метода (method="ИмяМетода").
// path = каталог: ищет *.bsl; несколько файлов — список путей; один файл — список объявлений.

Функция ВыполнитьReadModule(Аргументы) Экспорт
	Путь = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "path");
	Метод = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "method");

	Если ПустаяСтрока(Путь) Тогда
		Возврат Новый Структура("Текст, Ошибка", "Argument 'path' is required", Истина);
	КонецЕсли;

	Попытка
		Если FileSystem.КаталогСуществует(Путь) Тогда
			Возврат ОбработатьКаталог(Путь);
		ИначеЕсли FileSystem.ФайлСуществует(Путь) Тогда
			Возврат ОбработатьФайл(Путь, Метод);
		Иначе
			Возврат Новый Структура("Текст, Ошибка", "Not found: " + Путь, Истина);
		КонецЕсли;
	Исключение
		Возврат Новый Структура("Текст, Ошибка", "Error: " + ОписаниеОшибки(), Истина);
	КонецПопытки;
КонецФункции

// --- Каталог ---

Функция ОбработатьКаталог(Путь)
	Все = FileSystem.ПолучитьСписокЭлементов(Путь, 10);
	Файлы = Новый Массив;
	Для Каждого Эл Из Все Цикл
		Если Не Эл.ЭтоКаталог И СтрЗаканчиваетсяНа(НРег(Эл.Имя), ".bsl") Тогда
			Файлы.Добавить(Эл);
		КонецЕсли;
	КонецЦикла;

	Если Файлы.Количество() = 0 Тогда
		Возврат Новый Структура("Текст, Ошибка", "No *.bsl files found in: " + Путь, Истина);
	КонецЕсли;

	Если Файлы.Количество() > 1 Тогда
		Строки = Новый Массив;
		Строки.Добавить("Найдены следующие модули — какой хотите прочитать?");
		Для Каждого Ф Из Файлы Цикл
			Строки.Добавить("  " + Ф.ПолныйПуть);
		КонецЦикла;
		Строки.Добавить("Передайте полный путь к файлу в параметре path.");
		Возврат Новый Структура("Текст, Ошибка", СтрСоединить(Строки, Символ(10)), Ложь);
	КонецЕсли;

	// Один файл — возвращаем список объявлений
	ПутьКФайлу = Файлы[0].ПолныйПуть;
	Текст = FileSystem.ПрочитатьФайлКакТекст(ПутьКФайлу);
	Объявления = ИзвлечьОбъявления(Текст);
	Возврат СформироватьОтветОбъявления(ПутьКФайлу, Объявления);
КонецФункции

// --- Файл ---

Функция ОбработатьФайл(Путь, Метод)
	Текст = FileSystem.ПрочитатьФайлКакТекст(Путь);

	Если ПустаяСтрока(Метод) Тогда
		// Весь модуль
		Возврат Новый Структура("Текст, Ошибка", Текст, Ложь);
	КонецЕсли;

	Объявления = ИзвлечьОбъявления(Текст);

	Если Метод = "*" Тогда
		Возврат СформироватьОтветОбъявления(Путь, Объявления);
	КонецЕсли;

	// Конкретный метод
	Тело = НайтиТелоМетода(Текст, Метод, Объявления);
	Если Тело = Неопределено Тогда
		Имена = Новый Массив;
		Для Каждого Объявл Из Объявления Цикл
			Имена.Добавить(Объявл.Имя);
		КонецЦикла;
		Возврат Новый Структура("Текст, Ошибка",
			"Method '" + Метод + "' not found in " + Путь + "." + Символ(10) +
			"Available: " + СтрСоединить(Имена, ", "), Истина);
	КонецЕсли;

	Возврат Новый Структура("Текст, Ошибка", Тело, Ложь);
КонецФункции

// --- Парсинг объявлений ---

// Возвращает массив структур: Имя, Тип (Функция/Процедура), Экспорт (Булево), НомерСтроки.
Функция ИзвлечьОбъявления(ТекстМодуля)
	Строки = СтрРазделить(ТекстМодуля, Символ(10), Ложь);
	Объявления = Новый Массив;
	Для НомСтр = 0 По Строки.Количество() - 1 Цикл
		Стр = СокрЛП(Строки[НомСтр]);
		ВерхРегистр = ВРег(Стр);
		Тип = "";
		Если СтрНачинаетсяС(ВерхРегистр, "ФУНКЦИЯ ") Или СтрНачинаетсяС(ВерхРегистр, "ASYNC ФУНКЦИЯ ") Тогда
			Тип = "Функция";
		ИначеЕсли СтрНачинаетсяС(ВерхРегистр, "ПРОЦЕДУРА ") Или СтрНачинаетсяС(ВерхРегистр, "ASYNC ПРОЦЕДУРА ") Тогда
			Тип = "Процедура";
		КонецЕсли;
		Если Не ПустаяСтрока(Тип) Тогда
			Объявл = Новый Структура("Имя, Тип, Экспорт, НомерСтроки");
			Объявл.Тип = Тип;
			Объявл.НомерСтроки = НомСтр;
			Объявл.Экспорт = СтрНайти(ВерхРегистр, " ЭКСПОРТ") > 0;
			// Имя — между первым пробелом и открывающей скобкой
			ПозПробел = СтрНайти(Стр, " ");
			ПозСкобка = СтрНайти(Стр, "(");
			Если ПозСкобка > ПозПробел Тогда
				Объявл.Имя = СокрЛП(Сред(Стр, ПозПробел + 1, ПозСкобка - ПозПробел - 1));
			Иначе
				Объявл.Имя = СокрЛП(Сред(Стр, ПозПробел + 1));
			КонецЕсли;
			// Для async — имя после второго пробела
			Если СтрНачинаетсяС(ВерхРегистр, "ASYNC ") Тогда
				ПозПробел2 = СтрНайти(Стр, " ", ПозПробел + 1);
				ПозСкобка = СтрНайти(Стр, "(");
				Если ПозСкобка > ПозПробел2 Тогда
					Объявл.Имя = СокрЛП(Сред(Стр, ПозПробел2 + 1, ПозСкобка - ПозПробел2 - 1));
				КонецЕсли;
			КонецЕсли;
			Объявления.Добавить(Объявл);
		КонецЕсли;
	КонецЦикла;
	Возврат Объявления;
КонецФункции

Функция СформироватьОтветОбъявления(Путь, Объявления)
	Если Объявления.Количество() = 0 Тогда
		Возврат Новый Структура("Текст, Ошибка",
			"No methods found in " + Путь + "." + Символ(10) +
			"Use method=""*"" to get full module text.", Ложь);
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("Модуль: " + Путь);
	Строки.Добавить("Объявления (" + Объявления.Количество() + "):");
	Для Каждого Объявл Из Объявления Цикл
		Метка = ?(Объявл.Экспорт, " [Экспорт]", "");
		Строки.Добавить("  " + Объявл.Тип + " " + Объявл.Имя + Метка + "  (строка " + (Объявл.НомерСтроки + 1) + ")");
	КонецЦикла;
	Строки.Добавить("Для чтения метода: передайте path к файлу и method=""ИмяМетода"" (или method=""*"" для модуля целиком).");
	Возврат Новый Структура("Текст, Ошибка", СтрСоединить(Строки, Символ(10)), Ложь);
КонецФункции

// Возвращает текст тела метода (от строки объявления до КонецФункции/КонецПроцедуры включительно) или Неопределено.
Функция НайтиТелоМетода(ТекстМодуля, ИмяМетода, Объявления)
	Строки = СтрРазделить(ТекстМодуля, Символ(10), Ложь);
	НачСтр = -1;
	Для Каждого Объявл Из Объявления Цикл
		Если НРег(Объявл.Имя) = НРег(ИмяМетода) Тогда
			НачСтр = Объявл.НомерСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НачСтр = -1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Ищем КонецФункции / КонецПроцедуры начиная со следующей строки
	КонСтр = Строки.Количество() - 1;
	Для НомСтр = НачСтр + 1 По Строки.Количество() - 1 Цикл
		ВерхРегистр = ВРег(СокрЛП(Строки[НомСтр]));
		Если ВерхРегистр = "КОНЕЦФУНКЦИИ" Или ВерхРегистр = "КОНЕЦПРОЦЕДУРЫ"
			Или СтрНачинаетсяС(ВерхРегистр, "КОНЕЦФУНКЦИИ ")
			Или СтрНачинаетсяС(ВерхРегистр, "КОНЕЦПРОЦЕДУРЫ ") Тогда
			КонСтр = НомСтр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Фрагмент = Новый Массив;
	Для НомСтр = НачСтр По КонСтр Цикл
		Фрагмент.Добавить(Строки[НомСтр]);
	КонецЦикла;
	Возврат СтрСоединить(Фрагмент, Символ(10));
КонецФункции
