#Использовать sql

// Обработчик syntax_help_search (contracts §4.5): поиск по справке синтакс-помощника в SQLite (таблица nodes). LIKE по name и content.

Функция ВыполнитьSyntaxHelpSearch(Аргументы) Экспорт
	ПутьБД = РазрешитьПутьКБД(Аргументы);
	ЗапросСтрока = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "query");
	Лимит = ToolArgs.ПолучитьЧислоАргумента(Аргументы, "limit", 20);
	ДлинаФрагмента = ToolArgs.ПолучитьЧислоАргумента(Аргументы, "snippet_length", 200);

	Если ПустаяСтрока(ЗапросСтрока) Тогда
		Возврат Новый Структура("Текст, Ошибка", "Параметр query обязателен и не должен быть пустым.", Истина);
	КонецЕсли;
	Если Лимит < 1 Тогда
		Возврат Новый Структура("Текст, Ошибка", "Параметр limit должен быть не менее 1.", Истина);
	КонецЕсли;

	Если Не FileSystem.ФайлСуществует(ПутьБД) Тогда
		Возврат Новый Структура("Текст, Ошибка", "База справки не найдена: " + ПутьБД, Истина);
	КонецЕсли;

	Соединение = Неопределено;
	Попытка
		Соединение = Новый Соединение();
		Соединение.ТипСУБД = Соединение.ТипыСУБД.sqlite;
		Соединение.ИмяБазы = ПутьБД;
		Соединение.Открыть();
	Исключение
		Возврат Новый Структура("Текст, Ошибка", "Ошибка открытия БД: " + ОписаниеОшибки(), Истина);
	КонецПопытки;

	Попытка
		Запрос = Новый Запрос();
		Запрос.УстановитьСоединение(Соединение);
		Запрос.Текст = "SELECT id, name, path, content FROM nodes WHERE (name LIKE @pat OR (content IS NOT NULL AND content LIKE @pat)) LIMIT @limit";
		Запрос.УстановитьПараметр("pat", "%" + ЗапросСтрока + "%");
		Запрос.УстановитьПараметр("limit", Лимит);
		Выборка = Запрос.Выполнить().Выгрузить();
		Соединение.Закрыть();
	Исключение
		Если Соединение <> Неопределено Тогда
			Попытка Соединение.Закрыть(); Исключение КонецПопытки;
		КонецЕсли;
		Возврат Новый Структура("Текст, Ошибка", "Ошибка запроса к БД: " + ОписаниеОшибки(), Истина);
	КонецПопытки;

	Если Выборка.Количество() = 0 Тогда
		Возврат Новый Структура("Текст, Ошибка", "Совпадений не найдено.", Ложь);
	КонецЕсли;

	СтрокиРезультата = Новый Массив;
	Для Каждого Строка Из Выборка Цикл
		Имя = Строка.name;
		Контент = Строка.content;
		Если Контент = Неопределено Или ПустаяСтрока(Контент) Тогда
			СтрокиРезультата.Добавить(Имя);
		Иначе
			Фрагмент = СжатьКонтент(Контент, Имя, ДлинаФрагмента);
			СтрокиРезультата.Добавить(Имя + ": " + Фрагмент);
		КонецЕсли;
	КонецЦикла;

	ТекстРезультата = СтрСоединить(СтрокиРезультата, Символ(10));
	Возврат Новый Структура("Текст, Ошибка", ТекстРезультата, Ложь);
КонецФункции

// Убирает BOM, дублирующиеся строки и пустые строки; возвращает первые значимые строки до MaxLen символов.
Функция СжатьКонтент(Контент, Имя, МаксДлина)
	// Убрать BOM
	Текст = СтрЗаменить(Контент, Символ(65279), "");
	// Разбить на строки, убрать пустые и дубли имени
	Строки = СтрРазделить(Текст, Символ(10), Ложь);
	Уникальные = Новый Массив;
	УжеДобавлены = Новый Соответствие;
	Для Каждого Стр Из Строки Цикл
		Стр = СокрЛП(Стр);
		Если ПустаяСтрока(Стр) Тогда
			Продолжить;
		КонецЕсли;
		// Пропускаем строки, которые совпадают с именем статьи (дубль заголовка)
		Если Стр = Имя Тогда
			Продолжить;
		КонецЕсли;
		Если УжеДобавлены[Стр] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавлены.Вставить(Стр, Истина);
		Уникальные.Добавить(Стр);
	КонецЦикла;
	// Собираем результат до МаксДлина символов
	Результат = "";
	Для Каждого Стр Из Уникальные Цикл
		Если ПустаяСтрока(Результат) Тогда
			Результат = Стр;
		Иначе
			Результат = Результат + " | " + Стр;
		КонецЕсли;
		Если СтрДлина(Результат) >= МаксДлина Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Результат) > МаксДлина Тогда
		Результат = Лев(Результат, МаксДлина) + "...";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция РазрешитьПутьКБД(Аргументы)
	ПутьИзАргумента = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "dbPath");
	Если Не ПустаяСтрока(ПутьИзАргумента) Тогда
		Возврат ПутьИзАргумента;
	КонецЕсли;
	СИ = Новый СистемнаяИнформация;
	ПутьИзОкружения = СИ.ПолучитьПеременнуюСреды("SHCNTX_HELP_DB");
	Если Не ПустаяСтрока(ПутьИзОкружения) Тогда
		Возврат ПутьИзОкружения;
	КонецЕсли;
	// Дефолт: файл shcntx_help_db_path.txt (перезаписывается при старте main.os), cwd = каталог скрипта.
	ПутьФайлаДефолта = FileSystem.ОбъединитьПути(ТекущийКаталог(), "shcntx_help_db_path.txt");
	Если FileSystem.ФайлСуществует(ПутьФайлаДефолта) Тогда
		Попытка
			ПутьИзФайла = СокрЛП(FileSystem.ПрочитатьФайлКакТекст(ПутьФайлаДефолта));
			Если Не ПустаяСтрока(ПутьИзФайла) Тогда
				Возврат ПутьИзФайла;
			КонецЕсли;
		Исключение
			// оставляем fallback ниже
		КонецПопытки;
	КонецЕсли;
	Возврат "src/data/shcntx_help.db";
КонецФункции
