// Обработчик xml_search (contracts §4.2): поиск по XML-файлам. Формат результата: путь:номер:фрагмент. UTF-8.


Функция ВыполнитьXmlSearch(Аргументы) Экспорт
	Путь = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "path");
	Запрос = ToolArgs.ПолучитьЗначениеАргумента(Аргументы, "query");
	Если ПустаяСтрока(Путь) Тогда
		Возврат Новый Структура("Текст, Ошибка", "Argument 'path' is required", Истина);
	КонецЕсли;
	Если ПустаяСтрока(Запрос) Тогда
		Возврат Новый Структура("Текст, Ошибка", "Argument 'query' is required", Истина);
	КонецЕсли;
	Попытка
		Если Не FileSystem.КаталогСуществует(Путь) Тогда
			Возврат Новый Структура("Текст, Ошибка", "Directory not found: " + Путь, Истина);
		КонецЕсли;
		ФайлыXml = НайтиФайлы(Путь, "*.xml", Истина);
		Результат = Новый Массив;
		Для Каждого ФайлИнфо Из ФайлыXml Цикл
			Если ФайлИнфо.ЭтоКаталог() Тогда Продолжить; КонецЕсли;
			ПолныйПуть = ФайлИнфо.ПолноеИмя;
			ТекстФайла = FileSystem.ПрочитатьФайлКакТекст(ПолныйПуть);
			Строки = СтрРазделить(ТекстФайла, Символ(10), Ложь);
			НомерСтроки = 0;
			Для Каждого СтрокаТекста Из Строки Цикл
				НомерСтроки = НомерСтроки + 1;
				Если СтрНайти(СтрокаТекста, Запрос) > 0 Тогда
					Результат.Добавить(ПолныйПуть + ":" + Формат(НомерСтроки, "ЧГ=0") + ":" + СтрокаТекста);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Текст = СтрСоединить(Результат, Символ(10));
		Возврат Новый Структура("Текст, Ошибка", Текст, Ложь);
	Исключение
		Возврат Новый Структура("Текст, Ошибка", "Error searching XML: " + ОписаниеОшибки(), Истина);
	КонецПопытки;
КонецФункции
