// Use case: tools/call (contracts §3.3, §6.2–6.3). Маршрутизация по имени, вызов обработчика, result.content / isError.
// РеестрОбработчиков — Соответствие имён инструментов (наличие ключа = известный инструмент). Вызов по имени — внутри модуля (OneScript не передаёт функции как значения).
// Обработчики подключаются через #Использовать "src" в точке входа.

Функция ВызватьИнструмент(ИмяИнструмента, Аргументы, РеестрОбработчиков) Экспорт
	Результат = Новый Соответствие;
	Если РеестрОбработчиков.Получить(ИмяИнструмента) = Неопределено Тогда
		Результат.Вставить("content", СоздатьМассивКонтента("Unknown tool: " + ИмяИнструмента));
		Результат.Вставить("isError", Истина);
		Возврат Результат;
	КонецЕсли;
	Попытка
		ИсходОбработчика = ВызватьОбработчикПоИмени(ИмяИнструмента, Аргументы);
		Текст = ИсходОбработчика.Текст;
		ОшибкаИнструмента = ИсходОбработчика.Ошибка;
	Исключение
		Результат.Вставить("content", СоздатьМассивКонтента("Internal handler error: " + ОписаниеОшибки()));
		Результат.Вставить("isError", Истина);
		Возврат Результат;
	КонецПопытки;
	Результат.Вставить("content", СоздатьМассивКонтента(Текст));
	Результат.Вставить("isError", ОшибкаИнструмента);
	Возврат Результат;
КонецФункции

Функция ВызватьОбработчикПоИмени(Имя, Аргументы)
	Если Имя = "bsl_search" Тогда
		Возврат BslSearchHandler.ВыполнитьBslSearch(Аргументы);
	КонецЕсли;
	Если Имя = "xml_search" Тогда
		Возврат XmlSearchHandler.ВыполнитьXmlSearch(Аргументы);
	КонецЕсли;
	Если Имя = "config_list" Тогда
		Возврат ConfigListHandler.ВыполнитьConfigList(Аргументы);
	КонецЕсли;
	Если Имя = "read_module" Тогда
		Возврат ReadModuleHandler.ВыполнитьReadModule(Аргументы);
	КонецЕсли;
	Возврат Новый Структура("Текст, Ошибка", "Unknown tool", Истина);
КонецФункции

Функция СоздатьМассивКонтента(Текст)
	Массив = Новый Массив;
	Элемент = Новый Соответствие;
	Элемент.Вставить("type", "text");
	Элемент.Вставить("text", Текст);
	Массив.Добавить(Элемент);
	Возврат Массив;
КонецФункции
