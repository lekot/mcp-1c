// Use case: tools/list (contracts §3.2). Возврат списка инструментов из ToolRegistry.


Функция ПолучитьСписокИнструментов() Экспорт
	Инструменты = ToolRegistry.СписокИнструментов();
	Результат = Новый Соответствие;
	Результат.Вставить("tools", Инструменты);
	Возврат Результат;
КонецФункции
